# Copie ce fichier en ".env" et mets au moins UNE clé (toutes sont gratuites).
# Si plusieurs sont remplies, l'agent bascule automatiquement de l'une à l'autre.

# https://console.groq.com/keys  (rapide, recommandé)
GROQ_API_KEY=

# https://aistudio.google.com/apikey  (Gemini gratuit, secours quand Groq est saturé ou lent)
GEMINI_API_KEY=

# https://openrouter.ai/keys  (optionnel, Qwen gratuit)
OPENROUTER_API_KEY=

# --- En ligne (Render) : variables à définir dans le tableau de bord de l'hébergeur ---
# Base de données Postgres gratuite (Neon : https://neon.tech). Vide = SQLite local (data/app.db).
DATABASE_URL=
# Code d'invitation exigé pour créer un compte (conseillé si le site est public)
SIGNUP_CODE=
# Nombre maximum de messages par jour et par utilisateur (0 = illimité)
DAILY_LIMIT=50
# 0 = interdit à l'IA de modifier les fichiers Excel (analyse seulement)
ENABLE_EXCEL_SCRIPTS=1
# 0 = ferme les inscriptions
ALLOW_SIGNUP=1

# Optionnel : changer de modèle (les modèles gratuits changent souvent)
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.5-flash
